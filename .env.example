# Telegram Bot Configuration
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID tujuan notifikasi
TELEGRAM_CHAT_ID=your_chat_id_here

# News API Keys (Opsional - Jika ada)
NEWSDATA_API_KEY=your_newsdata_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# RapidAPI - Forex Factory Scraper (kalender ekonomi realtime)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_FF_HOST=forex-factory-scraper1.p.rapidapi.com
# Opsional (ms): RAPIDAPI_CALENDAR_TTL_MS, RAPIDAPI_MIN_INTERVAL_MS, RAPIDAPI_RELEASE_DELAY_MS, RAPIDAPI_RELEASE_WINDOW_MS

# Timezone (default: Asia/Jakarta = WIB)
TIMEZONE=Asia/Jakarta

# Cron expression untuk jadwal pengecekan
CRON_EXPRESSION=* * * * 1-5

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Environment: development atau production
NODE_ENV=development
